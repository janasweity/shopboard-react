{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/handler.ts": {
      "includeFiles": "generated/products.json"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/handler?path=/:path*"
    }
  ]
}
