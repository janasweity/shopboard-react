{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "products-api",
          "format": "url",
          "env": "RAHA_API_URL"
        }
      ]
    },
    "products-api": {
      "root": "products-api",
      "runtime": "node",
      "entrypoint": "api/handler.ts",
      "buildCommand": "npm run build",
      "functions": {
        "api/handler.ts": {
          "includeFiles": "generated/products.json"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
